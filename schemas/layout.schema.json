{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layout-only evidence v1",
  "type": "object",
  "required": ["schema_version", "evidence_type", "source", "class_id", "starting_bag_id", "confirmed_subclass_id", "board", "rounds"],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "OBSERVED_LAYOUT_ONLY" },
    "source": {
      "type": "object", "required": ["namespace", "build_id", "payload_sha256"],
      "properties": { "namespace": {"type":"string","minLength":1}, "build_id": {"type":"string","minLength":1}, "payload_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"} }
    },
    "class_id": {"type":"string","minLength":1},
    "starting_bag_id": {"type":"string","minLength":1},
    "confirmed_subclass_id": {"type":["string","null"],"minLength":1},
    "board": {"type":"object","required":["rows","cols"],"properties":{"rows":{"type":"integer","minimum":1},"cols":{"type":"integer","minimum":1}}},
    "rounds": {
      "type":"array", "minItems":1,
      "items": {
        "type":"object", "required":["round","coord_source","wallet","actions","placements"],
        "properties": {
          "round":{"type":"integer","minimum":1},
          "coord_source":{"enum":["SOURCE_EXACT","INVENTORY_ONLY_NO_COORDS"]},
          "wallet":{"type":"null"},
          "actions":{"type":"object","required":["buy","sell","craft","reroll","offers"],"properties":{"buy":{"type":"null"},"sell":{"type":"null"},"craft":{"type":"null"},"reroll":{"type":"null"},"offers":{"type":"null"}}},
          "placements":{"type":["array","null"],"items":{"$ref":"#/$defs/placement"}}
        },
        "allOf":[{"if":{"properties":{"coord_source":{"const":"INVENTORY_ONLY_NO_COORDS"}}},"then":{"properties":{"placements":{"type":"null"}}},"else":{"properties":{"placements":{"type":"array"}}}}]
      }
    }
  },
  "$defs": {
    "cell":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer"}},
    "placement":{
      "type":"object", "required":["instance_id","item_id","kind","r","c","rot","occupied_cells"],
      "properties":{
        "instance_id":{"type":"string","minLength":1},"item_id":{"type":"string","minLength":1},"kind":{"enum":["bag","item"]},
        "r":{"type":"integer"},"c":{"type":"integer"},"rot":{"type":"integer","minimum":0,"maximum":3},
        "occupied_cells":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/cell"}},
        "channels":{"type":"object","additionalProperties":{"type":"array","items":{"$ref":"#/$defs/cell"}}}
      }
    }
  }
}
